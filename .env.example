# 백엔드(Spring) 주소. 비워 두면 lib/mocks 목 응답으로 동작한다 (백엔드 없이 화면 확인용).
# 백엔드는 URL prefix 를 쓰지 않는다 — 경로가 곧 API 명세서의 경로다(`/rooms/public`).
# `/api/v1` 을 붙이면 전부 404 다.
#   로컬: http://localhost:8080
#   운영: https://api.passmate.kr
NEXT_PUBLIC_API_BASE_URL=

# STOMP 엔드포인트. 비우면 API 주소에서 유도하므로 보통 비워 둔다.
#   http://localhost:8080 → ws://localhost:8080/ws
#   https://api.passmate.kr → wss://api.passmate.kr/ws
NEXT_PUBLIC_WS_URL=

# 개발용 로그인(POST /auth/dev-login) 패널을 로그인 화면에 띄운다. `1` 일 때만 켜진다.
# 이 플래그는 main 에만 있다 — develop 에는 없어서 칸이 늘 뜬다(테스트용).
# main 배포는 CI 가 끈다(.github/workflows/deploy.yml).
NEXT_PUBLIC_ENABLE_DEV_LOGIN=
